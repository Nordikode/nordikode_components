{
  "name": "@nordikode/components",
  "version": "0.83.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nordikode/nordikode_components.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "bin",
    "index.d.ts",
    "tokens.d.ts",
    "web.d.ts",
    "bell.d.ts",
    "style.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./web": {
      "types": "./web.d.ts",
      "import": "./dist/web.js"
    },
    "./bell": {
      "types": "./bell.d.ts",
      "import": "./dist/bell.js"
    },
    "./style.css": "./style.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.6"
  },
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "icons:generate": "node bin/nk-mdi-registry.mjs --out .storybook/mdiRegistry.ts src"
  },
  "peerDependencies": {
    "@stripe/stripe-js": "^9.0.0",
    "vue": "^3.5.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/vue3-vite": "^10.5.9",
    "@stripe/stripe-js": "^9.17.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "storybook": "^10.5.9",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8",
    "vuetify": "^4.0.7"
  },
  "bin": {
    "nk-mdi-registry": "bin/nk-mdi-registry.mjs"
  },
  "peerDependenciesMeta": {
    "@stripe/stripe-js": {
      "optional": true
    }
  }
}
