{
  "name": "@nordikode/components",
  "version": "0.14.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nordikode/nordikode_components.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "tokens.d.ts",
    "web.d.ts",
    "style.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./web": {
      "types": "./web.d.ts",
      "import": "./dist/web.js"
    },
    "./style.css": "./style.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.6"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/vue3-vite": "^10.5.9",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "storybook": "^10.5.9",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8",
    "vuetify": "^4.0.7"
  }
}
